VITE_APP_CODE=APEX
#
# IMPORTANTE — Microfrontend embebido en Portal Apex (HTTPS):
# NO use http://127.0.0.1:3000 ni http://localhost en el artefacto que despliega el portal: el
# navegador bloquea HTTP desde página HTTPS (contenido mixto). Use ruta relativa al mismo host:
#
# VITE_API_BASE_URL=/ruta-del-gateway/itp-api
#
# Solo para Vite dev local (página también en http://), puede usar:
# VITE_API_BASE_URL=http://127.0.0.1:3000
# true = imprime en consola la base del API al primer request
# VITE_LOG_API_BASE=true
#
# Sin host Portal TI: permite ver la UI en Vite (sesión mock + permisos + JWT para Apex).
# Sin el JWT, `/incidentes/gti/*` responde 401 y las tablas de incidentes quedan vacías.
# VITE_STANDALONE_DEV=true
